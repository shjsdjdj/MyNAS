# Local-only by default. Set 0.0.0.0 only when LAN access is intentional.
MYNAS_HOST=127.0.0.1

# Required when using a named Cloudflare hostname through the Vite origin.
MYNAS_PUBLIC_HOST=mynas.example.com

# Backend security settings (set in PowerShell or Windows service environment).
MYNAS_ADMIN_USERNAME=admin
MYNAS_ADMIN_PASSWORD=replace-with-a-long-random-password
# Defaults to true (safe for production). Set to false ONLY for local HTTP development.
MYNAS_COOKIE_SECURE=false
MYNAS_JWT_EXPIRE_HOURS=24
MYNAS_MAX_UPLOAD_BYTES=2147483648
