# Runtime data (repo-root only — anchored with leading slash so backend/
# subdirectories such as backend/storage/ are never matched on case-insensitive
# filesystems like Windows NTFS).
/Storage/
/Thumbnails/
/Backup/
/Config/
/Logs/
/Temp/
/.tmp/
.preview-*/
artifacts/

# Cloudflare credentials (keep the example)
cloudflare/*.yml
!cloudflare/config.example.yml

